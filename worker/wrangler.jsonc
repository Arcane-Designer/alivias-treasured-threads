{
  "name": "att-review-inbox",
  "main": "worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "REVIEWS",
      "id": "9e2aefdea2c14eb88a6bd115fd95a96e"
    }
  ],
  "observability": {
    "enabled": true
  },
  "vars": {
    "PAYMENTS_MODE": "test",
    "SITE_URL": "https://arcane-designer.github.io/alivias-treasured-threads",
    "CATALOG_URL": "https://arcane-designer.github.io/alivias-treasured-threads/data/site.json"
  }
}
