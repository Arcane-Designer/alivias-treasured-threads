{
  "name": "att-review-inbox",
  "main": "worker.js",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "kv_namespaces": [
    {
      "binding": "REVIEWS",
      "id": "9e2aefdea2c14eb88a6bd115fd95a96e"
    }
  ],
  "d1_databases": [
    {
      "binding": "ORDERS",
      "database_name": "att-orders-production",
      "database_id": "d59154ed-2a99-4ae2-93bd-e9da93e23c88"
    }
  ],
  "secrets": {
    "required": ["STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET"]
  },
  "observability": {
    "enabled": true
  },
  "vars": {
    "PAYMENTS_MODE": "live",
    "SHIPPING_RATE_CENTS": "600",
    "SITE_URL": "https://aliviastreasuredthreads.com",
    "CATALOG_URL": "https://raw.githubusercontent.com/Arcane-Designer/alivias-treasured-threads/main/data/site.json"
  }
}
